OPENAI_API_KEY=
AURAVANCE_INGEST_API_KEY=
AURAVANCE_AUTH_SECRET_KEY=auravance-dev-secret-change-me
AURAVANCE_RAG_RESPONSE_MODEL=gpt-4.1-mini
AURAVANCE_RAG_EMBEDDING_MODEL=text-embedding-3-small
AURAVANCE_SEQUENCE_WINDOW_SIZE=12

# Leave these blank for SQLite + embedded MQTT + inline ingest scoring (pytest / laptop).
# After `docker compose up -d`, set:
# AURAVANCE_DATABASE_URL=postgresql://auravance:auravance@127.0.0.1:5433/auravance
# AURAVANCE_MQTT_EMBEDDED=false
# AURAVANCE_REDIS_URL=redis://127.0.0.1:6379/0
AURAVANCE_DATABASE_URL=
AURAVANCE_MQTT_ENABLED=true
AURAVANCE_MQTT_EMBEDDED=true
AURAVANCE_MQTT_BROKER_HOST=127.0.0.1
AURAVANCE_MQTT_BROKER_PORT=1883
AURAVANCE_REDIS_URL=
